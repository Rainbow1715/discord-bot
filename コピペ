# ==========================================
#  キャラクターデータ構造（辞書キー一覧）
# ==========================================

# --- 基本情報・設定 ---
"name"             # [文字列] キャラクター名
"icon"             # [文字列] アイコンデータ（Discord絵文字IDなど）
"gender"           # [文字列] 性別（"男", "女", "？"）
"rarity"           # [文字列] レアリティ（"★2" 〜 "★5"）
"element"          # [文字列] 属性（"赤", "青", "紫", "光" など）
"role"             # [文字列] 戦闘での役割（"アタッカー", "サポーター"）
"atk_type"         # [文字列] 攻撃タイプ（"物理", "魔法"）

# --- ステータス・成長 ---
"level"            # [数値] 現在のレベル
"exp"              # [数値] 現在の獲得経験値
"hp"               # [数値] 現在のHP
"max_hp"           # [数値] 最大HP
"atk"              # [数値] 攻撃力
"spd"              # [数値] 素早さ（行動順）
"rec"              # [数値] 回復力（回復スキル等の効果量）

# --- スキル関連 ---
"skill_name"       # [文字列] スキル名
"skill_type"       # [文字列] スキルの効果種別（"physical", "heal_all", "stun", "charm", "buff_all_atk" など）
"skill_pow"        # [数値] スキル威力・倍率
"skill_trigger"    # [文字列] 発動条件（例: "interval_3" = 3ターン毎）※一部キャラのみ
"skill_rate"       # [数値] 発動成功率(%)（例: 95 = 95%）※一部キャラのみ
"charm_target"     # [文字列] 魅了スキルの対象性別 ※一部キャラのみ

# --- 装備関連 ---
"best_equip"       # [文字列] 相性の良いモチーフ装備名
"equip"            # [None / 辞書] 現在装備中のアイテムデータ

# --- 好感度・交流システム ---
"likes"            # [辞書] 好きな食べ物とリアクション文 {"アイテム名": "テキスト"}
"dislikes"         # [辞書] 嫌いな食べ物とリアクション文 {"アイテム名": "テキスト"}
"affection_level"  # [数値] 現在の好感度レベル
"affection_exp"    # [数値] 現在の好感度経験値
"known_likes"      # [リスト] 発見済みの「好きなもの」リスト
"known_dislikes"   # [リスト] 発見済みの「嫌いなもの」リスト
